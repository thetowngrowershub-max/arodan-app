# ── Database ──
# With docker-compose, only POSTGRES_PASSWORD is needed (DATABASE_URL is set for you).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Elsewhere (e.g. a managed Postgres), give the full connection string:
# DATABASE_URL=postgresql://user:password@host:5432/arodan
# DATABASE_SSL=true

# ── Sign-in ──
# Long random string (at least 32 characters). Keep it secret; changing it signs everyone out.
JWT_SECRET=
SESSION_DAYS=60
OTP_LENGTH=6

# ── Public address (only for the https profile in docker-compose) ──
# Your domain, or a free one made from the server's IP: api.<ip-with-dashes>.sslip.io
DOMAIN=

# ── Sign-in codes ──
# termii: we create the code and Termii texts it.
# messagecentral: Message Central creates, sends (SMS or WhatsApp) and checks the code.
# With no credentials for the chosen provider, codes are written to the server log instead.
SMS_PROVIDER=termii

# Message Central (https://www.messagecentral.com): Customer ID and password from your account
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_PASSWORD=
MESSAGECENTRAL_FLOW=SMS

# Termii (https://termii.com)
TERMII_API_KEY=
TERMII_SENDER_ID=Arodan
TERMII_CHANNEL=dnd
# TERMII_BASE_URL=https://api.ng.termii.com

# Testers: fixed codes, no SMS sent. Format phone:code, comma-separated. Remove before launch.
TEST_OTP_PHONES=2348031234567:123456

# Which websites may call the API from a browser (* = any). Phones are not affected.
CORS_ORIGIN=*

# ── Rider bank payouts (Paystack) ──
# Secret key from Paystack > Settings > API Keys & Webhooks (sk_test_… while testing, sk_live_… for real money).
# Without it, riders' earnings build up in their balance but cannot be withdrawn.
PAYSTACK_SECRET_KEY=

# ── Push notifications (Expo) ──
# Only needed if you turn on "enhanced security for push notifications" in your Expo account.
EXPO_ACCESS_TOKEN=
# PUSH_ENABLED=false   # stop sending push notifications
# WORKERS=false        # don't run background jobs (push sending, payout checks) on this server
