# ── Database ──
# With docker-compose, only POSTGRES_PASSWORD is needed (DATABASE_URL is set for you).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Elsewhere (e.g. a managed Postgres), give the full connection string:
# DATABASE_URL=postgresql://user:password@host:5432/arodan
# DATABASE_SSL=true

# ── Sign-in ──
# Long random string (at least 32 characters). Keep it secret; changing it signs everyone out.
JWT_SECRET=
SESSION_DAYS=60
OTP_LENGTH=6

# ── SMS (Termii) ──
# Without an API key, codes are written to the server log instead of being texted.
TERMII_API_KEY=
TERMII_SENDER_ID=Arodan
TERMII_CHANNEL=dnd
# TERMII_BASE_URL=https://api.ng.termii.com

# Testers: fixed codes, no SMS sent. Format phone:code, comma-separated. Remove before launch.
TEST_OTP_PHONES=2348031234567:123456

# Which websites may call the API from a browser (* = any). Phones are not affected.
CORS_ORIGIN=*
