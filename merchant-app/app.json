{
  "expo": {
    "name": "Arodan Merchant",
    "slug": "arodan-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arodan.merchant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06805A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arodan.merchant"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Arodan Merchant uses your photos to show your products to customers.",
          "cameraPermission": "Arodan Merchant uses the camera to take product photos."
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#FFFFFF"
    }
  }
}
