{
  "expo": {
    "name": "Arodan Rider",
    "slug": "arodan-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arodan.rider"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06805A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arodan.rider"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Arodan shares your location with the customer and dispatch while you are online or on a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Arodan uses the camera to photograph packages at drop-off as proof of delivery.",
          "photosPermission": false
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#FFFFFF"
    }
  }
}
