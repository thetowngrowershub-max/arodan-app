# Copy this file to .env and fill in the values from Supabase: Project Settings > API.
# Leave them empty to run the offline demo (fake data, code 1234).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Must match Supabase: Authentication > Sign In / Providers > Phone > OTP length (default 6).
EXPO_PUBLIC_OTP_LENGTH=6
